generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// Parent product line (e.g. "Retatrutide") — owns the one storefront URL and
// everything shared across sizes. Sellable SKUs live on ProductVariant below.
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  categoryId    String
  description   String?
  benefits      String?
  dosageInfo    String?
  coaUrl        String?
  featured      Boolean  @default(false)
  // Manual curation order among featured products (lower = shown first).
  // Ties (the common case — everything starts at 0) fall back to
  // createdAt desc, so this is inert until an admin actually reorders.
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  // True for supply items that should only ever be sold bundled as another
  // product's add-on (e.g. a free syringe/alcohol swab included with a
  // peptide) — never independently browsable/purchasable on their own
  // storefront page. Deliberately separate from `active`: `active` still
  // gates whether this is allowed to appear as an add-on at all (see
  // products.controller.ts), so setting active:false to hide it from the
  // catalog would also silently break it as an add-on everywhere it's used.
  addOnOnly     Boolean  @default(false)
  // Plain-text nudge shown near Add to Cart on the storefront (e.g. "This
  // peptide needs Bacteriostatic Water to reconstitute") — informational
  // only, distinct from the required/forced ProductAddOn mechanism below.
  addOnReminder String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  // Add-ons this product line offers on its page (e.g. BAC Water for a
  // lyophilized peptide), regardless of which variant/size is purchased.
  // Points down to the specific sellable ProductVariant being offered.
  addOns   ProductAddOn[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

// A single sellable SKU (one size/strength) belonging to a parent Product.
// This table held the flat one-row-per-size product data before the
// parent/variant rework — ids were preserved as-is (see the migration
// script), so every OrderItem/ProductAddOn.addOnId reference kept working
// unchanged across the rework.
model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  code         String    @unique
  size         String?
  price        Int
  // Genuine time-limited sale — null salePrice means "not on sale". A sale is
  // only considered active when salePrice is set AND the current time falls
  // within [saleStartsAt, saleEndsAt]. See backend/src/utils/product-pricing.ts
  // (and its frontend counterpart) for the single source of truth on this
  // logic — order creation, storefront display, and JSON-LD must all agree.
  salePrice    Int?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  stock        Int       @default(0)
  // Purchase floor independent of pricing — stops a bulk-only SKU being
  // ordered as a single unit through the storefront.
  moq          Int       @default(1)
  imageUrl     String?
  // Lets one size be discontinued without touching the parent or its other
  // sizes — a variant can never be hard-deleted once an order references it
  // (OrderItem's FK below has no cascade), so this is the only way to retire one.
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product           Product         @relation(fields: [productId], references: [id])
  priceTiers        PriceTier[]
  batches           Batch[]
  kitItems          KitItem[]
  quotationItems    QuotationItem[]
  orderItems        OrderItem[]
  offeredAsAddOnFor ProductAddOn[]

  @@index([productId])
  @@index([active])
  @@map("product_variants")
}

// Quantity-break pricing: the row with the highest minQty <= the requested
// quantity wins, open-ended until the next tier. Feeds the *suggested* price
// on the storefront/quote builder — OrderItem/QuotationItem.unitPrice is
// always its own stored snapshot, so a negotiated quote can still override it.
model PriceTier {
  id        String @id @default(cuid())
  variantId String
  minQty    Int
  unitPrice Int

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
  @@index([variantId])
  @@map("price_tiers")
}

// Explicit join model for a Product-to-ProductVariant add-on relation.
// productId = the parent product line whose page shows the add-on (applies
// regardless of which of its own variants is purchased); addOnId = the
// specific sellable variant being offered (e.g. a particular Bac Water size).
model ProductAddOn {
  id        String  @id @default(cuid())
  productId String
  addOnId   String
  // Force-selected and locked on the storefront product page — the customer
  // cannot uncheck it. Enforced again server-side at order-creation time
  // (see createOrder) so a bypassed/omitted client request still can't ship
  // a reconstitution-requiring peptide without its required supplies.
  required  Boolean @default(false)
  // Fixed quantity added when this add-on is included — intentionally does
  // NOT scale with the parent product's purchased quantity.
  quantity  Int     @default(1)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOn   ProductVariant @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([productId, addOnId])
  @@map("product_add_ons")
}

// B2B lifecycle — no Pricing Approval / Purchasing(PO) stages: stock is
// pre-secured via PreorderCampaign/Batch ahead of time, there's nothing to
// buy per order. PARTIALLY_SHIPPED covers an order whose items span more
// than one Shipment where not all of them have gone out yet.
enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPED
  PARTIALLY_SHIPPED
  DELIVERED
  COMPLETE
  CANCELLED
}

// Still B2C's enum, reused as-is for Payment.method below (bank transfer vs
// the existing Billplz gateway) — untouched to avoid disturbing the existing
// gateway/webhook plumbing that references it.
enum PaymentMethod {
  WHATSAPP
  BILLPLZ
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  companyId         String
  // Set only when this order originated from an accepted Quotation — a quote
  // converts to at most one order, hence @unique here.
  quotationId       String?     @unique
  shippingAddressId String
  // Set only for a pay-now order — a direct link to the zero-item Invoice
  // created at order time, so the email worker and admin invoice generation
  // can find "the payment for this order" without heuristic matching on
  // company+total+timing. Shipment-triggered invoices (the normal
  // multi-order billing case) intentionally have no such link — this exists
  // solely for the one-invoice-per-order pay-now special case.
  prepaidInvoiceId  String?     @unique
  subtotal          Int         @default(0)
  shippingFee       Int         @default(0)
  discountAmount    Int         @default(0)
  discountCodeId    String?
  total             Int
  status            OrderStatus @default(PENDING)
  notes             String?
  idempotencyKey    String?     @unique
  // Soft-delete only — admin "Delete" never removes the row, it just moves
  // the order into a separate Deleted view (set) / back out of it (null).
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company         Company              @relation(fields: [companyId], references: [id])
  quotation       Quotation?           @relation(fields: [quotationId], references: [id])
  shippingAddress CompanyAddress       @relation(fields: [shippingAddressId], references: [id])
  discountCode    DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  prepaidInvoice  Invoice?             @relation("PrepaidInvoice", fields: [prepaidInvoiceId], references: [id])
  items           OrderItem[]
  shipments       Shipment[]
  statusHistory   OrderStatusHistory[]
  emails          EmailOutbox[]

  @@index([companyId])
  @@index([status])
  @@index([orderNumber])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("orders")
}

// Batch assignment lives on ShipmentItem, not here — which lot physically
// got picked is a fulfillment-time decision, not an order-time one.
// variantId/kitId are mutually exclusive (enforced app-side, not by a DB
// constraint): a line is either a plain variant or a kit.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  variantId String?  @map("productId")
  kitId     String?
  quantity  Int
  unitPrice Int
  createdAt DateTime @default(now())

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  kit           Kit?            @relation(fields: [kitId], references: [id])
  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([kitId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  shipmentNumber String    @unique
  shippedAt      DateTime?
  carrier        String?
  trackingNumber String?
  createdAt      DateTime  @default(now())

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ShipmentItem[]

  @@index([orderId])
  @@map("shipments")
}

// The physical pick: one row per (orderItem, batch) actually fulfilled. A kit
// OrderItem can fan out into several ShipmentItem rows — one per component
// variant's batch — even though it traces back to a single ordered line.
// This also means a shipment's compliance docs are just Batch.coaUrl for
// every batch its ShipmentItems reference — no separate document table.
model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  batchId     String
  quantity    Int

  shipment    Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  batch       Batch        @relation(fields: [batchId], references: [id])
  invoiceItem InvoiceItem?

  @@index([shipmentId])
  @@index([orderItemId])
  @@index([batchId])
  @@map("shipment_items")
}

// Belongs to Company, not Order — this is the shipment/invoice decoupling:
// one invoice can bundle ShipmentItems from multiple orders/shipments in the
// same billing period (e.g. monthly consolidated billing under credit
// terms), rather than being forced 1:1 with a single order's shipment.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  companyId     String
  issueDate     DateTime @default(now())
  // issueDate + Company.creditTerms, set when the invoice is issued
  // (= shipment time), never at order-placement time — a NET30 clock
  // starting on a 6-week-out preorder would make it overdue before the
  // goods even arrive.
  dueDate       DateTime
  total         Int
  // paid/partially-paid/overdue are computed from sum(Payment.amount) vs
  // total and dueDate vs now — no stored status to keep in sync via a cron.
  // void is the one genuine event worth storing.
  void          Boolean  @default(false)
  createdAt     DateTime @default(now())

  company         Company       @relation(fields: [companyId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  prepaidForOrder Order?        @relation("PrepaidInvoice")

  @@index([companyId])
  @@map("invoices")
}

// One ShipmentItem is billed exactly once — hence @unique on shipmentItemId.
model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  shipmentItemId String @unique
  amount         Int

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipmentItem ShipmentItem @relation(fields: [shipmentItemId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  amount     Int
  method     PaymentMethod
  paymentRef String?
  paidAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

enum EmailType {
  ORDER_CONFIRMATION
  PAYMENT_RECEIPT
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  // Set from the Resend webhook (modules/webhooks/resend-webhook.controller.ts)
  // once a SENT row's message reaches one of these terminal delivery states.
  DELIVERED
  BOUNCED
  COMPLAINED
}

// Transactional-email outbox: state changes (order created, payment
// confirmed) insert a row here inside the SAME transaction as the state
// change, and a background worker (utils/email-worker.ts) drains it via
// Resend. Emails are never sent inline — a gateway outage can't fail a
// checkout, and a crashed send is retried instead of lost.
model EmailOutbox {
  id            String      @id @default(cuid())
  orderId       String
  type          EmailType
  toEmail       String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  resendId      String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // At most one email of each type per order — payment callbacks can fire
  // twice, so enqueue uses skipDuplicates against this instead of erroring.
  @@unique([orderId, type])
  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]

  @@map("discount_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CreditTerms {
  PREPAID
  NET15
  NET30
  NET60
}

// A Company IS the login — passwordHash lives directly here rather than a
// separate contacts table (one business = one account = one row). New
// signups default to PREPAID and can transact immediately; there's no
// separate approval/pending flag — admin upgrading creditTerms later *is*
// the approval step.
model Company {
  id              String      @id @default(cuid())
  // Collected at signup alongside email + password — the account's own handle,
  // and the label shown wherever a company name isn't set yet. Login is still
  // by email; this is an identifier, not a second credential.
  username        String      @unique
  // Nullable because signup no longer asks for it — a trade account is opened
  // from contact details alone, and the legal entity name is captured
  // afterwards via the business-profile step. Order and quotation creation
  // both refuse to proceed while it's null, since it's the bill-to line on
  // every invoice and quotation PDF.
  name            String?
  taxId           String?
  // Also nullable, same reason as `name` — signup is email + password only.
  // The business-profile step captures these, and ordering/quoting is blocked
  // until all three are present (see assertProfileComplete): the payment
  // gateway's bill payload and the receipt/quotation PDFs all require them.
  contactName     String?
  phone           String?
  email           String      @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  creditTerms     CreditTerms @default(PREPAID)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  addresses  CompanyAddress[]
  orders     Order[]
  quotations Quotation[]
  invoices   Invoice[]

  @@map("companies")
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

model CompanyAddress {
  id        String      @id @default(cuid())
  companyId String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  postcode  String
  type      AddressType @default(BOTH)
  createdAt DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId])
  @@map("company_addresses")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// References Variant/Kit generically, never a specific Batch — negotiation
// happens before a specific arrival is locked in; the actual batch gets
// assigned like any other order, at fulfillment time. A rejected quote is
// just replaced by a new Quotation row — no versioning/supersession chain.
model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String          @unique
  companyId   String
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime
  createdBy   String
  subtotal    Int             @default(0)
  total       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  items   QuotationItem[]
  order   Order?

  @@index([companyId])
  @@index([status])
  @@map("quotations")
}

// variantId/kitId are mutually exclusive (app-enforced), same convention as
// OrderItem below.
model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  variantId   String?
  kitId       String?
  quantity    Int
  // Negotiated price — may differ from the catalog price/PriceTier.
  unitPrice   Int

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  kit       Kit?            @relation(fields: [kitId], references: [id])

  @@index([quotationId])
  @@index([variantId])
  @@index([kitId])
  @@map("quotation_items")
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
  SOLD_OUT
}

model PreorderCampaign {
  id               String         @id @default(cuid())
  name             String
  opensAt          DateTime
  closesAt         DateTime
  estimatedArrival DateTime
  status           CampaignStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  batches Batch[]
  kits    Kit[]

  @@map("preorder_campaigns")
}

enum BatchStatus {
  INCOMING
  IN_STOCK
  DEPLETED
}

model Batch {
  id          String      @id @default(cuid())
  variantId   String
  campaignId  String?
  batchNumber String      @unique
  expiry      DateTime
  coaUrl      String?
  quantity    Int
  status      BatchStatus @default(INCOMING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variant       ProductVariant    @relation(fields: [variantId], references: [id])
  campaign      PreorderCampaign? @relation(fields: [campaignId], references: [id])
  shipmentItems ShipmentItem[]

  @@index([variantId])
  @@index([campaignId])
  @@map("batches")
}

model Kit {
  id          String   @id @default(cuid())
  campaignId  String?
  name        String
  pricePerKit Int
  qtyPerKit   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign       PreorderCampaign? @relation(fields: [campaignId], references: [id])
  items          KitItem[]
  quotationItems QuotationItem[]
  orderItems     OrderItem[]

  @@index([campaignId])
  @@map("kits")
}

model KitItem {
  id        String @id @default(cuid())
  kitId     String
  variantId String
  quantity  Int

  kit     Kit            @relation(fields: [kitId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([kitId])
  @@index([variantId])
  @@map("kit_items")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}
